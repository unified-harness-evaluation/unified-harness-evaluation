# Copy to .env, fill in real values, then: source .env
export AZURE_API_KEY=your-azure-api-key-here
export AZURE_API_BASE=https://your-endpoint.openai.azure.com/
export AZURE_API_VERSION=2024-12-01-preview
export AZURE_AI_API_KEY=your-azure-ai-api-key-here
# AI-Services inference host for non-OpenAI models (Kimi, DeepSeek, grok); keep the /models path
export AZURE_AI_API_BASE=https://your-ai-endpoint.services.ai.azure.com/models
